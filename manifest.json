{
  "manifest_version": 3,
  "name": "VT Link Scanner",
  "version": "2.4.0",
  "description": "Pre-click link protection with VirusTotal plus automatic completed-download monitoring and file scanning workflow.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "contextMenus",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*",
    "https://*.virustotal.com/*",
    "https://rdap.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VT Link Scanner",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
